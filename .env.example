# ---- Obligatoire : rien (l'application démarre sans clé) ----

# Clé secrète des sessions. Laisse vide : une clé aléatoire est créée et gardée dans secret.key
STV_SECRET_KEY=

# Mot de passe du compte admin à la 1re création. Laisse vide : un mot de passe aléatoire
# est généré et écrit dans ADMIN_MOT_DE_PASSE.txt
ADMIN_PASSWORD=

# ---- Directs officiels YouTube (gratuit, optionnel) ----
# Google Cloud > activer "YouTube Data API v3" > Identifiants > Clé API
# Quota gratuit : 10 000 unités/jour, une recherche = 100 unités (cache 15 min intégré)
YOUTUBE_API_KEY=

# ---- Résumés ScoreBat (flux libre, aucune clé nécessaire) ----
SCOREBAT_URL=https://www.scorebat.com/video-api/v3/
SCOREBAT_TOKEN=

# ---- Scores en direct tous sports (optionnel) ----
SPORTSAPI_KEY=
SPORTSAPI_BASE_URL=https://api.sportsapi.app
